#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    chosen {
        zmk,physical-layout = &five_col_layout;
    };
};

/ {
    behaviors {
        // Home-row mods. Tap = the letter, hold = the modifier.
        // require-prior-idle-ms is the anti-misfire setting: mid-word the hold
        // is ignored entirely, so fast typing can't trip a modifier.
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        // Hold B to send the tmux/herdr prefix. tap-preferred means the hold
        // only fires after the full term even if another key is pressed, so
        // rolling through B while typing stays a plain letter.
        pfx: prefix_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        // Entry to the SYSTEM layer is a *hold*, not a chord.
        //
        // Every previous guard here was positional -- pick keys that typing
        // cannot roll -- and every one of them eventually misfired, because the
        // thing actually pressing them was not typing. A hand grabbing the
        // board by its edge, or the board pressed against something in a bag,
        // presses a whole region at once, and no choice of three key positions
        // survives that. require-prior-idle-ms does not help either: a board
        // being picked up has been idle for hours.
        //
        // Time is the guard that region-presses cannot pass. 750ms of sustained
        // hold is not something a grip or a bag does. Both branches are &to,
        // which also sidesteps hold-tap's requirement that both behaviours take
        // exactly one parameter -- and makes the accidental case harmless: a
        // short squeeze lands on &to 0 and just re-asserts the base layer.
        sys: system_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <750>;
            bindings = <&to>, <&to>;
        };

        // Cmd+Tab app switcher. Presses Cmd on the first detent, pulses Tab on
        // each one after, and releases Cmd on any other key or layer change --
        // which here means letting go of the NUMBER layer commits the switch.
        swapper: swapper {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;
        };

        // Encoder rotations that need something richer than a plain keypress.
        pane_cycle: pane_cycle {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&pane_next>, <&pane_prev>;
        };

        // Clockwise runs the swapper. Anticlockwise is a bare Shift+Tab, which
        // walks backwards through the switcher because the swapper is already
        // holding Cmd down.
        app_switch: app_switch {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&swapper>, <&kp LS(TAB)>;
        };
    };

    macros {
        // herdr / tmux pane cycling. The prefix is a *sequence*, not a chord:
        // press Ctrl+B, release, then Tab.
        pane_next: pane_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B)>, <&kp TAB>;
        };

        pane_prev: pane_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B)>, <&kp LS(TAB)>;
        };

        // prefix + z -- zoom the current pane to fullscreen, press again to
        // restore. Sits on the press of the same dial that cycles panes.
        pane_zoom: pane_zoom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B)>, <&kp Z>;
        };
    };

    // Layer latches live on combos rather than on a key inside the layer.
    // This ZMK is pinned to v0.3, which has no layer "locking": a &tog fired
    // while the layer is held sees it already active, flips it off, and then
    // the thumb release turns it off again -- so nothing happens. A combo
    // fires with no layer held, so &tog behaves.
    //
    //   Q + X together  -> latch NUMBER   (same combo again to leave)
    //   ; + . together  -> latch SYMBOL
    //   , + . together  -> switch to QWERTY (P + / in QWERTY terms, since it is
    //                      the same two physical keys; same combo to come back)
    //   N + Q together  -> back to the base layer, unconditionally (panic key)
    combos {
        compatible = "zmk,combos";

        // 150ms, not 40ms. 40ms is inside the noise floor of a deliberate
        // two-key press -- these latches were effectively unfireable, which
        // also meant SYMBOL could be entered by the thumb and then not left,
        // since the same combo is the only way out. Same finger or same hand
        // on every combo here, so nothing in this range can be rolled by
        // accident during typing.
        combo_lock_num {
            timeout-ms = <150>;
            key-positions = <24 25>;
            bindings = <&tog 1>;
        };

        combo_lock_sym {
            timeout-ms = <150>;
            key-positions = <32 33>;
            bindings = <&tog 2>;
        };

        // Panic key. Nothing else in this keymap is an unconditional &to 0, so
        // any latch that would not unlatch meant a power cycle. Left pinky,
        // home row + bottom row: same finger, unrollable, and on the left half
        // so it works with the right half off or unpaired.
        combo_base {
            timeout-ms = <150>;
            key-positions = <12 24>;
            bindings = <&to 0>;
        };

        // Fall back to QWERTY while Gallium is still being learned. Has to be a
        // combo rather than a key parked on NUMBER: layer 3 outranks layer 1, so
        // once QWERTY is on it would shadow any toggle key sitting underneath it
        // and there would be no way back. Combos fire regardless of layer.
        //
        // Top and bottom of the right pinky column -- same finger, so it cannot
        // be rolled by accident, and it mirrors the B + Q bootloader combo on the
        // left. Right half only, which is fine for a layout switch (unlike the
        // bootloader, which deliberately stays reachable with the right half off).
        combo_qwerty {
            timeout-ms = <50>;
            key-positions = <11 33>;
            bindings = <&tog 3>;
        };

        // Entry to SYSTEM, which is where everything that can break
        // connectivity now lives. Hold all three for 750ms; a shorter press is
        // &to 0 and does nothing you would notice.
        //
        // Positions are deliberately *interior* to the left half. The pinky
        // column is the edge a hand grabs when it picks the board up, and the
        // old bootloader combo sat on top and bottom of exactly that column --
        // which is how the board kept ending up in the UF2 bootloader. Nothing
        // here is on it. Left half only, so SYSTEM is still reachable when the
        // right half is off, flat or unpaired -- which is precisely when you
        // need it.
        //
        // W and not Z for the bottom-row key: Z carries the pfx hold-tap, and a
        // 750ms hold on a hold-tap member is asking for a stray Ctrl+B.
        combo_system {
            timeout-ms = <150>;
            require-prior-idle-ms = <250>;
            key-positions = <2 27 35>;
            bindings = <&sys 4 0>;
        };

        // Bootloader is B + Q -- top and bottom of the left pinky column, the
        // same chord as before -- but restricted to SYSTEM. On every other
        // layer it is inert, so the geometry stops mattering: you cannot reach
        // it without holding your way into SYSTEM first. Two deliberate acts,
        // and the second one is only available after the first.
        combo_bootloader {
            timeout-ms = <50>;
            layers = <4>;
            key-positions = <0 24>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "GALLIUM";
            // ---------------------------------------------------------------------------------
            // |  B  |  L  |  D  |  C  |  V  | WISPR |  PLAY  |  J  |  Y  |  O  |  U  |  ,  |
            // |  N  |  R  |  T  |  S  |  G  | STCKY |   -    |  P  |  H  |  A  |  E  |  I  |
            // |  Q  |  X  |  M  |  W  |  Z  |                   K  |  F  |  '  |  ;  |  .  |
            //             | ESC/NUM | CMD | SPACE |     | RET | TAB/SYM | BSPC |
            //
            // Gallium v2, column-stagger variant. Replaces QWERTY because A and P
            // were unreachable with the little fingers -- both now sit on the right
            // hand's strong fingers (A = middle, P = index), on the home row.
            //
            // Modifiers, left hand only so the right hand can stay on the mouse.
            // The pinky and ring columns carry NO holds at all -- that was half the
            // original complaint -- so the three non-Cmd mods share the three
            // strongest fingers, one mod per finger:
            //
            //   T = Shift (middle)   S = Option (index)   G = Ctrl (index inner)
            //   CMD = left thumb, a plain key, no letter involved
            //
            // One mod per finger is what makes Ctrl+Shift and Ctrl+Option chordable
            // at all. The order is deliberately inverted against letter frequency:
            // Ctrl, whose misfire is destructive, sits on G (2%), the rarest letter
            // here; Shift, whose misfire is a visible capital, takes T (9%), the
            // commonest. Ctrl+T works because they are different fingers -- hold G,
            // tap T.
            //
            // Z holds for the Ctrl+B prefix: near-zero frequency, so a safe host.
            bindings = <
                &kp B       &kp L       &kp D        &kp C       &kp V             &kp RCTRL   &kp C_PP    &kp J   &kp Y   &kp O     &kp U    &kp COMMA
                &kp N       &kp R       &hm LSHFT T  &hm LALT S  &hm LCTRL G       &sk LSHFT   &kp MINUS   &kp P   &kp H   &kp A     &kp E    &kp I
                &kp Q       &kp X       &kp M        &kp W       &pfx LC(B) Z                              &kp K   &kp F   &kp SQT   &kp SEMI &kp DOT
                                        &lt 1 ESC    &kp LGUI    &kp SPACE                     &kp RET     &lt 2 TAB   &kp BSPC
            >;
            // Slots: left_ex1, left_ex2, right_ex1, right_ex2. Both slots per
            // half share a binding, so it works whichever socket the encoder
            // is actually soldered into.
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN     // left dial  -> volume
                               &inc_dec_kp C_VOL_UP C_VOL_DN
                               &inc_dec_kp C_NEXT C_PREV         // right dial -> track skip
                               &inc_dec_kp C_NEXT C_PREV>;
        };

        lower_layer {
            display-name = "NUMBER";
            // ---------------------------------------------------------------------------------
            // |  F1 |  F2 |  F3 |  F4 |  F5 | CMD-` | ZOOM |  /  |  7  |  8  |  9  |  *  |
            // |SHOT4|     |     |     |     |       | SHOT5|  -  |  4  |  5  |  6  |  +  |
            // |     |     | CAPS|     |     |                  0  |  1  |  2  |  3  |  .  |
            //
            // Numpad sits under the right hand in the usual 789 / 456 / 123 grid,
            // with the operators on the outer columns. Q + X together latches
            // this layer on so you can let go of the thumb; same combo to leave.
            //
            // The BT profiles, BTCLR, OUT, Studio unlock and the RGB toggle all
            // used to live on this layer's left half. They are on SYSTEM now.
            // Moving them one column inward (the previous fix) shrank the blast
            // radius but left them one thumb-hold from the base layer, and a
            // thumb-hold is not a meaningful barrier in front of a key that can
            // silence the board. The freed positions are &none rather than
            // &trans: a stray press here should do nothing, not fall through to
            // a letter.
            //
            // OUT and BTCLR -- now on SYSTEM -- are the two connectivity escape
            // hatches, both added after a session where the board typed fine
            // over USB, reported itself paired over Bluetooth, and sent
            // nothing. OUT toggles the output endpoint: ZMK persists that
            // preference, so a board left preferring USB goes silent the moment
            // the cable comes out, with
            // nothing in the keymap to switch it back. BTCLR wipes the bond on
            // the *current* profile only, for when a profile is poisoned on
            // both ends -- previously the only recourse was to walk to one of
            // the four unused BT_SEL slots and eventually run out.
            //
            // Dial presses pair with what each dial does on this layer: the left
            // dial picks an app, its press walks that app's windows; the right
            // dial finds a pane, its press zooms it.
            //
            // Screenshots sit on the inner columns -- Cmd+Shift+4 for a region
            // (left hand only, so the mouse is free to drag it out) and
            // Cmd+Shift+5 for the capture toolbar. Cmd+Shift+4 keeps the pinky
            // home position it inherited when the BT keys moved out.
            bindings = <
                &kp F1         &kp F2  &kp F3      &kp F4  &kp F5           &kp LG(GRAVE)     &pane_zoom       &kp FSLH  &kp N7    &kp N8    &kp N9    &kp ASTRK
                &kp LG(LS(N4)) &none   &none       &none   &none            &none             &kp LG(LS(N5))   &kp MINUS &kp N4    &kp N5    &kp N6    &kp PLUS
                &none          &none   &caps_word  &none   &none                             &kp N0    &kp N1    &kp N2    &kp N3    &kp DOT
                                             &trans       &trans       &trans                   &trans  &trans    &trans
            >;
            sensor-bindings = <&app_switch      // left dial  -> Cmd+Tab
                               &app_switch
                               &pane_cycle      // right dial -> herdr panes
                               &pane_cycle>;
        };

        raise_layer {
            display-name = "SYMBOL";
            // ---------------------------------------------------------------------------------
            // |  !  |  @  |  #  |  $  |  %  |     |     |  [  |  ]  |  {  |  }  |  =  |
            // |  ^  |  &  |  *  |  (  |  )  |     |     |  -  |  _  |  ^  |  +  |  ?  |
            // |  ~  |  `  | "|" |  \  |  /  |                 <  |  <- |  v  |  -> |  >  |
            //
            // Every symbol lives on the left half. The right hand gets an
            // inverted-T of arrows -- described by position rather than by
            // letter, so it survives the next layout change: UP is the right
            // hand's middle-finger home key, with LEFT / DOWN / RIGHT on the
            // three bottom-row keys under it. Navigation without leaving home.
            //
            // ; + . together latches this layer, mirroring Q + X on NUMBER.
            //
            // "/" lives here rather than on the base layer: Gallium has no
            // base-layer slot for it, and keeping the alphas canonical means
            // any typing trainer matches the board. "?" takes the right pinky
            // home key, which was a second ";" -- redundant, since ";" already
            // has a base-layer slot. Without it "?" needed sticky shift plus
            // this layer plus "/", three presses across both halves.
            bindings = <
                &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &trans     &trans  &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC   &kp EQUAL
                &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR   &trans     &trans  &kp MINUS &kp UNDER &kp UP    &kp PLUS   &kp QMARK
                &kp TILDE &kp GRAVE &kp PIPE  &kp BSLH  &kp FSLH                     &kp LT    &kp LEFT  &kp DOWN  &kp RIGHT  &kp GT
                                    &trans    &trans    &trans             &trans  &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp LG(LS(Z)) LG(Z)   // left dial -> redo / undo
                               &inc_dec_kp LG(LS(Z)) LG(Z)
                               &inc_dec_kp C_VOL_UP C_VOL_DN
                               &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // The old QWERTY layer, kept live for as long as Gallium is still being
        // learned -- and for handing the board to someone else. Reached with the
        // , + . combo (right pinky column, top and bottom); the same combo comes
        // back. Everything except the alphas matches the base layer, so the
        // thumbs, dials, sticky shift and both mod layers behave identically
        // whichever alphabet is live.
        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
                &kp Q       &kp W       &kp E       &kp R        &kp T           &kp RCTRL   &kp C_PP   &kp Y   &kp U   &kp I     &kp O   &kp P
                &hm LCTRL A &hm LALT S  &hm LGUI D  &hm LSHFT F  &kp G           &sk LSHFT   &kp SQT    &kp H   &kp J   &kp K     &kp L   &kp MINUS
                &kp Z       &kp X       &kp C       &kp V        &pfx LC(B) B                           &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH
                                        &lt 1 ESC   &kp LGUI     &kp SPACE                   &kp RET    &lt 2 TAB   &kp BSPC
            >;
        };

        // Everything that can take the keyboard away from you lives here and
        // nowhere else. Reached only by holding D + W + CMD for 750ms; left by
        // the inner left thumb, or by the N + Q panic combo from anywhere.
        //
        // ---------------------------------------------------------------------------------
        // |     |     |     |     |     |     |     |     |     |     |     |     |
        // | BT0 | BT1 | BT2 | BT3 | BT4 |     |     |     |     |     |     |     |
        // |UNLCK| RGB |     |BTCLR| OUT |                 |     |     |     |     |
        //             |     |     |BASE |     |     |     |     |
        //
        // The left half carries all of it, on purpose: the moment you need this
        // layer is the moment the right half may be off, flat or unpaired, and
        // a recovery key you cannot reach is not a recovery key.
        //
        // BT profiles run along the home row, one tap each, because walking the
        // five slots is the single most common thing you come here to do.
        // BTCLR and OUT keep the bottom-row positions they had on NUMBER, so
        // the muscle memory built up over the last two lockouts still works.
        //
        // &bootloader is deliberately not a key. It is combo_bootloader
        // (B + Q), gated to this layer -- so reaching it is a hold, then a
        // chord, and neither happens by accident.
        //
        // Every unused position is &none. On a layer where a single tap can
        // flip the output endpoint, a key that does nothing is worth more than
        // a key that falls through to a letter.
        system_layer {
            display-name = "SYSTEM";
            bindings = <
                &none          &none           &none &none      &none        &none  &none  &none &none &none &none &none
                &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none &none &none &none &none &none &none
                &studio_unlock &rgb_ug RGB_TOG &none &bt BT_CLR &out OUT_TOG               &none &none &none &none &none
                                               &none &none     &to 0                &none &none &none
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };
    };
};
