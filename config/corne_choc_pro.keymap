#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &five_col_layout;
    };
};

/ {
    behaviors {
        // Home-row mods. Tap = the letter, hold = the modifier.
        // require-prior-idle-ms is the anti-misfire setting: mid-word the
        // hold is ignored entirely, so fast typing can't trip a modifier.
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            // ------------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  | ^B(dial) | MUTE(dial) |  Y  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |  R-CTRL  |     '      |  H  |  J  |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |                          N  |  M  |  ,  |  .  |  /  |
            //             | CMD | ESC/NAV | SPACE |          | RET | TAB/SYM | BSPC |
            //
            // Home-row holds (left only, right hand stays on the mouse):
            //   A = Ctrl    S = Option    D = Cmd    F = Shift
            bindings = <
                &kp Q       &kp W       &kp E       &kp R        &kp T   &kp LC(B)   &kp C_MUTE   &kp Y   &kp U   &kp I     &kp O   &kp P
                &hm LCTRL A &hm LALT S  &hm LGUI D  &hm LSHFT F  &kp G   &kp RCTRL   &kp SQT      &kp H   &kp J   &kp K     &kp L   &kp SEMI
                &kp Z       &kp X       &kp C       &kp V        &kp B                            &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH
                                        &kp LGUI    &lt 1 ESC    &kp SPACE            &kp RET     &lt 2 TAB   &kp BSPC
            >;
            // Slots: left_ex1, left_ex2, right_ex1, right_ex2.
            // Both slots per half get the same binding, so it works whichever
            // physical position the encoder is soldered into.
            sensor-bindings = <&inc_dec_kp LG(EQUAL) LG(MINUS)   // left dial  -> Cmd+ / Cmd-  (Figma zoom)
                               &inc_dec_kp LG(EQUAL) LG(MINUS)
                               &inc_dec_kp C_VOL_UP C_VOL_DN     // right dial -> volume
                               &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "NUMBER";
            // ------------------------------------------------------------------------------------------
            // |  1  |  2  |  3  |  4  |  5  |          |          |  6  |  7  |  8  |  9  |  0  |
            // | BT1 | BT2 | BT3 | BT4 | BT5 |          |          | LFT | DWN |  UP | RGT | DEL |
            // |BTCLR| RGB |RESET|BOOT |UNLCK|                     |HOME |PGDN |PGUP | END |     |
            bindings = <
                &kp N1       &kp N2          &kp N3       &kp N4       &kp N5         &trans  &trans  &kp N6    &kp N7    &kp N8   &kp N9    &kp N0
                &bt BT_SEL 0 &bt BT_SEL 1    &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans  &trans  &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT &kp DEL
                &bt BT_CLR   &rgb_ug RGB_TOG &sys_reset   &bootloader  &studio_unlock                 &kp HOME  &kp PG_DN &kp PG_UP &kp END  &trans
                                             &trans       &trans       &trans                 &trans  &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP
                               &inc_dec_kp PG_DN PG_UP
                               &inc_dec_kp C_NEXT C_PREV
                               &inc_dec_kp C_NEXT C_PREV>;
        };

        raise_layer {
            display-name = "SYMBOL";
            // ------------------------------------------------------------------------------------------
            // |  !  |  @  |  #  |  $  |  %  |          |          |  ^  |  &  |  *  |  (  |  )  |
            // |  ~  |  `  |  {  |  }  | "|" |          |          |  -  |  =  |  [  |  ]  |  \  |
            // | HUD | HUI |     |     |     |                     |  _  |  +  |     |     |     |
            bindings = <
                &kp EXCL        &kp AT          &kp HASH  &kp DLLR &kp PRCNT &trans  &trans  &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR
                &kp TILDE       &kp GRAVE       &kp LBRC  &kp RBRC &kp PIPE  &trans  &trans  &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH
                &rgb_ug RGB_HUD &rgb_ug RGB_HUI &trans    &trans   &trans                    &kp UNDER &kp PLUS  &trans    &trans   &trans
                                                &trans    &trans   &trans            &trans  &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp LG(LS(Z)) LG(Z)   // left dial -> redo / undo
                               &inc_dec_kp LG(LS(Z)) LG(Z)
                               &inc_dec_kp C_VOL_UP C_VOL_DN
                               &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_3 {
            display-name = "EXTRA 3";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_4 {
            display-name = "EXTRA 4";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans
                              &trans &trans &trans               &trans &trans &trans
            >;
        };
    };
};
